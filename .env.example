# Copy to .env and fill in. Never commit .env - it is gitignored.
# Run `nina doctor` after editing to validate everything at once.

# ---------------------------------------------------------------------------
# Required: LiveKit connection
# Create a project at https://cloud.livekit.io and copy its keys.
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Required for the default provider: Google Gemini
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Model stack
# google_realtime : one speech-to-speech model (Gemini Live). Default, lowest latency.
# pipeline        : separate STT -> LLM -> TTS via LiveKit inference. Swappable per stage.
# ---------------------------------------------------------------------------
# NINA_PROVIDER=google_realtime

# Realtime provider settings
# NINA_REALTIME_MODEL=gemini-2.0-flash-exp
# NINA_VOICE=Puck
# NINA_TEMPERATURE=0.8

# Pipeline provider settings (ignored unless NINA_PROVIDER=pipeline)
# NINA_STT_MODEL=deepgram/nova-3
# NINA_STT_LANGUAGE=multi
# NINA_LLM_MODEL=google/gemini-2.0-flash
# NINA_TTS_MODEL=cartesia/sonic-2
# NINA_TTS_VOICE=

# ---------------------------------------------------------------------------
# Persona
# ---------------------------------------------------------------------------
# NINA_ASSISTANT_NAME=NINA
# NINA_USER_NAME=Shan
# NINA_USER_FULL_NAME=Shanmuga Priyan
# NINA_INTERESTS=basketball,badminton,creative writing,audio gear,prompt engineering
# NINA_EXTRA_INSTRUCTIONS=
# NINA_GREET_ON_START=true

# ---------------------------------------------------------------------------
# Tools
# Comma-separated subset of: clock, weather, search, memory. Use "none" to disable all.
# ---------------------------------------------------------------------------
# NINA_TOOLS=clock,weather,search,memory

# duckduckgo (keyless, limited) | tavily (needs a key, much better) | none
# NINA_SEARCH_PROVIDER=duckduckgo
# TAVILY_API_KEY=

# NINA_MEMORY_ENABLED=true
# NINA_MEMORY_PATH=.nina/memory.json
# NINA_MEMORY_MAX_ITEMS=200
# NINA_MEMORY_MAX_VALUE_CHARS=500

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# bvc | bvc_telephony | none   (LiveKit Cloud enhancement; ignored if self-hosting)
# NINA_NOISE_CANCELLATION=bvc
# NINA_HTTP_TIMEOUT=10
# NINA_LOG_LEVEL=info
# NINA_LOG_FORMAT=text
